%% =====================================================================
%% Mesa de Ayuda Comunicarlos — Diagrama de Secuencia e Interacción Multicapa
%% Flujo secuencial de ejecución: Cliente -> API -> Auth -> Servicio -> Dominio -> Mongo -> Observer
%% Dominio rico: el router pasa el Usuario autenticado completo (actor) y la
%% entidad le PREGUNTA si puede ejecutar la transición (double dispatch).
%% Compilado a HTML con docs/diagramas/compilar_mermaid.py (ver README).
%% =====================================================================
graph TD

    subgraph sg_cliente["1. CAPA CLIENTE (Web / Desktop)"]
        cli_req["(1) Solicitante envía formulario<br/>POST /requerimientos<br/>Payload JSON + Token Bearer"]
        cli_res_ok["(10) Recibe HTTP 201 Created<br/>RequerimientoResponse con UUID"]
        cli_op_res["(11) Técnico envía resolución<br/>POST /requerimientos/{id}/resolver<br/>Nota obligatoria + Token Bearer"]
        cli_res_resuelto["(21) Recibe HTTP 200 OK<br/>Ticket en estado RESUELTO"]
        cli_sup_admin["(22) Supervisor consulta notificaciones<br/>GET /notificaciones + Token Bearer"]
    end

    subgraph sg_api["2. CAPA API & SEGURIDAD (FastAPI / Auth)"]
        api_router_crear["(2) app.requerimientos.router: crear_requerimiento"]
        api_auth_guard["(3) app.deps: obtener_usuario_actual(token)<br/>• Decodifica JWT (python-jose)<br/>• Recarga el usuario desde el repositorio<br/>• Inyecta la subclase concreta (Solicitante, Tecnico...)"]
        api_router_resolver["(12) app.requerimientos.router: resolver<br/>Sin guard de rol: pasa el Usuario actual completo<br/>servicio.resolver(id, nota, usuario_actual)"]
        api_permiso_guard["(23) app.deps: requerir_permiso(lambda u: u.recibe_notificaciones())<br/>• Le PREGUNTA al usuario (no compara roles)<br/>• Solo Supervisor responde True; resto → 403"]
    end

    subgraph sg_servicio["3. CAPA SERVICIOS DE APLICACIÓN (solo orquestación)"]
        srv_crear["(4) ServicioRequerimientos.crear(...)<br/>Coordina fábrica, persistencia y eventos"]
        srv_resolver["(14) ServicioRequerimientos.resolver(id, nota, actor)<br/>Busca el ticket (existencia) y delega la regla al dominio<br/>Sin ningún if de rol, estado ni ids"]
    end

    subgraph sg_dominio["4. CAPA DOMINIO (Information Expert, Double Dispatch & Factory)"]
        dom_fabrica["(5) FabricaRequerimientos.crear(tipo, ...)<br/>• Instancia Incidente o Solicitud<br/>• Valida invariantes de formato<br/>• Estado inicial: ABIERTO"]
        dom_evento_creacion["(6) Registra EventoRequerimiento(CREACION)<br/>en historial embebido de la entidad"]
        dom_entidad_resolver["(15) Requerimiento.resolver(nota, actor)<br/>• Valida estado actual == EN_PROGRESO<br/>• Pregunta actor.puede_resolver(self)<br/>• Valida nota_resolucion no vacía<br/>• Cambia estado a RESUELTO"]
        dom_actor_pregunta["(15b) Tecnico.puede_resolver(req)<br/>→ req.esta_asignado_a(self)<br/>(Supervisor responde True; Operador/Solicitante False)"]
        dom_evento_resolucion["(16) Registra EventoRequerimiento(RESOLUCION)<br/>autor_id = actor.id"]
        dom_relacion_notificar["(19c) RelacionSupervision.notificar(evento)<br/>• Exige audita_a(evento.autor_id)<br/>• Devuelve Notificacion para su supervisor"]
    end

    subgraph sg_infra["5. CAPA PERSISTENCIA (MongoDB PyMongo)"]
        repo_guardar_crear["(7) RepositorioRequerimientosMongo.guardar(req)"]
        db_insert["(8) pymongo: db.requerimientos.replace_one(upsert=True)<br/>Persistencia atómica del documento con historial"]
        repo_buscar_resolver["(13) RepositorioRequerimientosMongo.buscar_por_id(id)<br/>Reconstruye Incidente/Solicitud vía FabricaRequerimientos"]
        repo_guardar_resolver["(17) RepositorioRequerimientosMongo.guardar(req)"]
        db_update["(18) pymongo: actualiza estado a RESUELTO<br/>y persiste nota de resolución e historial"]
    end

    subgraph sg_eventos["6. CAPA EVENTOS & OBSERVADORES (Observer Pattern)"]
        despachador_crear["(9) DespachadorEventos.notificar(evento_creacion)<br/>• ObservadorLogger loggea auditoría<br/>• autor.es_supervisable() == False (Solicitante)"]
        despachador_resolver["(19) DespachadorEventos.notificar(evento_resolucion)<br/>• ObservadorLogger registra resolución"]
        obs_mongo["(19b) ObservadorNotificacionesMongo.actualizar(evento)<br/>• Busca al autor y le pregunta es_supervisable()<br/>• RepositorioSupervision.listar_supervisores_de(autor.id)<br/>• Por cada relación: relacion.notificar(evento)"]
        db_notif_insert["(20) db.notificaciones.insert_one(notificacion)<br/>Queda lista para visualización en tiempo real"]
    end

    %% Secuencia Escenario 1: Creación de Requerimiento
    cli_req -->|"HTTP POST /requerimientos"| api_router_crear
    api_router_crear -->|"Valida token"| api_auth_guard
    api_auth_guard -->|"Inyecta actor (Usuario)"| api_router_crear
    api_router_crear -->|"Invoca caso de uso"| srv_crear
    srv_crear -->|"Solicita instancia"| dom_fabrica
    dom_fabrica -->|"Genera evento inicial"| dom_evento_creacion
    dom_evento_creacion -->|"Retorna entidad Requerimiento"| srv_crear
    srv_crear -->|"Persistir entidad"| repo_guardar_crear
    repo_guardar_crear -->|"Operación PyMongo"| db_insert
    db_insert -->|"Confirmado"| srv_crear
    srv_crear -->|"Despachar evento"| despachador_crear
    srv_crear -->|"Retorna a Router"| api_router_crear
    api_router_crear -->|"Respuesta HTTP 201"| cli_res_ok

    %% Secuencia Escenario 2: Resolución Técnica (double dispatch)
    cli_op_res -->|"HTTP POST /requerimientos/{id}/resolver"| api_router_resolver
    api_router_resolver -->|"Valida token"| api_auth_guard
    api_auth_guard -->|"Inyecta Tecnico autenticado"| api_router_resolver
    api_router_resolver -->|"resolver(id, nota, actor)"| srv_resolver
    srv_resolver -->|"Recupera entidad"| repo_buscar_resolver
    repo_buscar_resolver -->|"Requerimiento reconstruido"| srv_resolver
    srv_resolver -->|"req.resolver(nota, actor)"| dom_entidad_resolver
    dom_entidad_resolver -->|"actor.puede_resolver(self)"| dom_actor_pregunta
    dom_actor_pregunta -->|"True (es el asignado)"| dom_entidad_resolver
    dom_entidad_resolver -->|"Agrega evento resolución"| dom_evento_resolucion
    dom_evento_resolucion -->|"Retorna EventoRequerimiento"| srv_resolver
    srv_resolver -->|"Persistir nuevo estado"| repo_guardar_resolver
    repo_guardar_resolver -->|"Operación PyMongo"| db_update
    db_update -->|"Confirmado"| srv_resolver
    srv_resolver -->|"Despachar evento"| despachador_resolver
    despachador_resolver -->|"Notifica observador"| obs_mongo
    obs_mongo -->|"Pide la notificación a la relación"| dom_relacion_notificar
    dom_relacion_notificar -->|"Notificacion"| obs_mongo
    obs_mongo -->|"Inserta alerta supervisor"| db_notif_insert
    srv_resolver -->|"Retorna a Router"| api_router_resolver
    api_router_resolver -->|"Respuesta HTTP 200"| cli_res_resuelto

    %% Secuencia Escenario 3: Endpoint sin entidad que pregunte → requerir_permiso
    cli_sup_admin -->|"HTTP GET /notificaciones"| api_permiso_guard
    api_permiso_guard -->|"Valida token"| api_auth_guard
    api_permiso_guard -.->|"Lee alertas persistidas"| db_notif_insert

    %% Estilos por Capa
    classDef capaCli fill:#1e3a5f,stroke:#4a90d9,stroke-width:2px,color:#eaf2fb
    classDef capaApi fill:#0f3d2e,stroke:#3fbf8f,stroke-width:2px,color:#e8fbf4
    classDef capaSrv fill:#123a4d,stroke:#39a8d0,stroke-width:2px,color:#e7f7fd
    classDef capaDom fill:#3d2a5c,stroke:#a179e0,stroke-width:2px,color:#f3ecff
    classDef capaInfra fill:#4a1f2b,stroke:#d9647f,stroke-width:2px,color:#fdeaef
    classDef capaEvt fill:#553d0a,stroke:#e0b73f,stroke-width:2px,color:#fff8e1

    class cli_req,cli_res_ok,cli_op_res,cli_res_resuelto,cli_sup_admin capaCli
    class api_router_crear,api_auth_guard,api_router_resolver,api_permiso_guard capaApi
    class srv_crear,srv_resolver capaSrv
    class dom_fabrica,dom_evento_creacion,dom_entidad_resolver,dom_actor_pregunta,dom_evento_resolucion,dom_relacion_notificar capaDom
    class repo_guardar_crear,db_insert,repo_buscar_resolver,repo_guardar_resolver,db_update capaInfra
    class despachador_crear,despachador_resolver,obs_mongo,db_notif_insert capaEvt
