graph LR
    subgraph sg_ciclo["CICLO DE VIDA DEL REQUERIMIENTO (EstadoRequerimiento, 6 estados reales)"]
        direction LR
        st_inicial(("Inicio<br/>pseudo-estado"))
        st_abierto(["ABIERTO<br/>ticket recien creado, sin triage"])
        st_analisis(["EN_ANALISIS<br/>en triage; aqui se asigna/reasigna tecnico"])
        st_progreso(["EN_PROGRESO<br/>tecnico trabajando"])
        st_resuelto(["RESUELTO<br/>resuelto con nota; espera conformidad"])
        st_cerrado(["CERRADO<br/>TERMINAL: conformidad dada"])
        st_cancelado(["CANCELADO<br/>TERMINAL: desestimado"])
    end

    subgraph sg_guardas["GUARDAS Y ERRORES DE DOMINIO (app/requerimientos/excepciones.py + app/errores.py)"]
        direction TB
        gd_existe{"buscar_por_id id: existe?<br/>ServicioRequerimientos._buscar_o_lanzar"}
        gd_tecnico{"tecnico_asignado_id is not None?"}
        gd_asignado{"actor == tecnico asignado o rol == SUPERVISOR?"}
        gd_nota{"nota_resolucion sin espacios: no vacia?"}
        err_noexiste["RequerimientoNoEncontradoError<br/>HTTP 404"]
        err_transicion["TransicionInvalidaError<br/>HTTP 409"]
        err_tecnico["TecnicoNoAsignadoError<br/>HTTP 409"]
        err_nota["NotaResolucionRequeridaError<br/>HTTP 409"]
        err_permiso["PermisoDenegadoError<br/>HTTP 403"]
    end

    subgraph sg_roles["MATRIZ DE PERMISOS POR ROL (RolUsuario, CLAUDE.md)"]
        direction TB
        rol_solicitante(["SOLICITANTE<br/>crea propio · comenta propio · cierra propio · cancela SOLO desde ABIERTO y propio"])
        rol_operador(["OPERADOR<br/>inicia analisis · asigna tecnico · comenta · cierra · cancela (ABIERTO/EN_ANALISIS/EN_PROGRESO) · NO deriva"])
        rol_tecnico(["TECNICO<br/>inicia progreso si asignado · resuelve si asignado · comenta si asignado · deriva si asignado · NUNCA cierra ni cancela"])
        rol_supervisor(["SUPERVISOR<br/>todo el ciclo salvo comentar y derivar · unico destinatario de Notificacion"])
    end

    subgraph sg_eventos["EVENTOS DE AUDITORIA EMITIDOS (TipoEventoRequerimiento, 9 tipos)"]
        direction TB
        ev_creacion["CREACION"]
        ev_cambio["CAMBIO_ESTADO"]
        ev_asignacion["ASIGNACION"]
        ev_resolucion["RESOLUCION"]
        ev_cierre["CIERRE"]
        ev_cancelacion["CANCELACION"]
        ev_comentario["COMENTARIO"]
        ev_derivacion["DERIVACION"]
        ev_reapertura["REAPERTURA"]
    end

    %% --- Transiciones T1-T16 (Requerimiento en app/requerimientos/dominio/base.py) ---
    st_inicial ==>|"T1 constructor via FabricaRequerimientos.crear<br/>POST /requerimientos · cualquier rol crea lo propio"| st_abierto
    st_abierto ==>|"T2 metodo iniciar_analisis<br/>POST /{id}/iniciar-analisis · OPERADOR o SUPERVISOR<br/>orden: estado -> permiso"| st_analisis
    st_analisis -->|"T3 metodo asignar_tecnico self-loop<br/>POST /{id}/asignar-tecnico · OPERADOR o SUPERVISOR · NO cambia estado<br/>orden: estado -> permiso"| st_analisis
    st_analisis ==>|"T4 metodo iniciar_progreso<br/>POST /{id}/iniciar-progreso · tecnico asignado o SUPERVISOR<br/>orden: estado -> tecnico_asignado -> permiso"| st_progreso
    st_progreso ==>|"T5 metodo resolver con nota<br/>POST /{id}/resolver · tecnico asignado o SUPERVISOR<br/>orden: estado -> permiso -> nota"| st_resuelto
    st_resuelto ==>|"T6 metodo cerrar<br/>POST /{id}/cerrar · solicitante propio, OPERADOR o SUPERVISOR · TECNICO nunca<br/>orden: estado -> permiso"| st_cerrado
    st_abierto -->|"T7 metodo cancelar<br/>POST /{id}/cancelar · solicitante propio (solo ABIERTO), OPERADOR o SUPERVISOR<br/>orden: estado -> permiso"| st_cancelado
    st_analisis -->|"T8 metodo cancelar<br/>POST /{id}/cancelar · solo OPERADOR o SUPERVISOR<br/>orden: estado -> permiso"| st_cancelado
    st_progreso -->|"T9 metodo cancelar<br/>POST /{id}/cancelar · solo OPERADOR o SUPERVISOR<br/>orden: estado -> permiso"| st_cancelado
    st_abierto -->|"T10 metodo agregar_comentario self-loop<br/>POST /{id}/comentarios · solicitante propio, OPERADOR, o TECNICO asignado<br/>orden: estado -> permiso -> texto"| st_abierto
    st_analisis -->|"T11 metodo agregar_comentario self-loop<br/>POST /{id}/comentarios · idem T10<br/>orden: estado -> permiso -> texto"| st_analisis
    st_progreso -->|"T12 metodo agregar_comentario self-loop<br/>POST /{id}/comentarios · idem T10<br/>orden: estado -> permiso -> texto"| st_progreso
    st_resuelto -->|"T13 metodo agregar_comentario self-loop<br/>comentario de SOLICITANTE dueno sobre RESUELTO: NO reabre<br/>orden: estado -> permiso -> texto"| st_resuelto
    st_resuelto ==>|"T14 REAPERTURA via agregar_comentario<br/>comentario de OPERADOR o TECNICO asignado sobre RESUELTO -> vuelve a EN_PROGRESO, 2 eventos<br/>orden: estado -> permiso -> texto"| st_progreso
    st_analisis -->|"T15 metodo derivar_interconsulta self-loop<br/>POST /{id}/derivar · solo el TECNICO actualmente asignado<br/>orden: estado -> permiso -> destino!=origen"| st_analisis
    st_progreso -->|"T16 metodo derivar_interconsulta self-loop<br/>POST /{id}/derivar · solo el TECNICO actualmente asignado<br/>orden: estado -> permiso -> destino!=origen"| st_progreso

    %% --- Precedencia global: la busqueda por id (404) precede a toda guarda de estado/permiso/datos ---
    st_analisis -.->|"toda operacion T2-T16 busca primero por id: 404 precede a 409/403"| gd_existe
    gd_existe -.->|"no"| err_noexiste

    %% --- Guardas especificas y sus rechazos ---
    st_analisis -.->|"T4"| gd_tecnico
    gd_tecnico -.->|"no"| err_tecnico
    st_progreso -.->|"T4"| gd_asignado
    gd_asignado -.->|"no"| err_permiso
    st_progreso -.->|"T5"| gd_nota
    gd_nota -.->|"no"| err_nota

    %% --- Transiciones prohibidas desde/hacia estados terminales o incompatibles ---
    st_cerrado -.->|"comentar o cancelar: prohibido"| err_transicion
    st_cancelado -.->|"comentar o cancelar: prohibido"| err_transicion
    st_resuelto -.->|"cancelar: prohibido"| err_transicion
    st_abierto -.->|"iniciar-progreso/resolver/cerrar/derivar fuera de estado: prohibido"| err_transicion

    %% --- Matriz de permisos: rol -> transicion que puede disparar ---
    rol_solicitante -.->|"T1"| st_abierto
    rol_solicitante -.->|"T6 propio"| st_cerrado
    rol_solicitante -.->|"T7 propio, solo ABIERTO"| st_cancelado
    rol_solicitante -.->|"T10 propio"| st_abierto
    rol_solicitante -.->|"T11 propio"| st_analisis
    rol_solicitante -.->|"T12 propio"| st_progreso
    rol_solicitante -.->|"T13 propio, no reabre"| st_resuelto

    rol_operador -.->|"T1"| st_abierto
    rol_operador -.->|"T2"| st_analisis
    rol_operador -.->|"T3 asignar"| st_analisis
    rol_operador -.->|"T6"| st_cerrado
    rol_operador -.->|"T7"| st_cancelado
    rol_operador -.->|"T8"| st_cancelado
    rol_operador -.->|"T9"| st_cancelado
    rol_operador -.->|"T10-T12"| st_progreso
    rol_operador -.->|"T14 reapertura"| st_progreso

    rol_tecnico -.->|"T1"| st_abierto
    rol_tecnico -.->|"T4 si asignado"| st_progreso
    rol_tecnico -.->|"T5 si asignado"| st_resuelto
    rol_tecnico -.->|"T10-T12 si asignado"| st_progreso
    rol_tecnico -.->|"T14 reapertura si asignado"| st_progreso
    rol_tecnico -.->|"T15 solo asignado"| st_analisis
    rol_tecnico -.->|"T16 solo asignado"| st_progreso

    rol_supervisor -.->|"T1"| st_abierto
    rol_supervisor -.->|"T2"| st_analisis
    rol_supervisor -.->|"T3 asignar"| st_analisis
    rol_supervisor -.->|"T4"| st_progreso
    rol_supervisor -.->|"T5"| st_resuelto
    rol_supervisor -.->|"T6"| st_cerrado
    rol_supervisor -.->|"T7-T9"| st_cancelado

    %% --- Transicion -> eventos emitidos (TipoEventoRequerimiento) ---
    st_abierto -.->|"T1"| ev_creacion
    st_analisis -.->|"T2"| ev_cambio
    st_analisis -.->|"T3"| ev_asignacion
    st_progreso -.->|"T4"| ev_cambio
    st_resuelto -.->|"T5"| ev_resolucion
    st_cerrado -.->|"T6"| ev_cierre
    st_cancelado -.->|"T7"| ev_cancelacion
    st_cancelado -.->|"T8"| ev_cancelacion
    st_cancelado -.->|"T9"| ev_cancelacion
    st_abierto -.->|"T10"| ev_comentario
    st_analisis -.->|"T11"| ev_comentario
    st_progreso -.->|"T12"| ev_comentario
    st_resuelto -.->|"T13"| ev_comentario
    st_progreso -.->|"T14 (1 de 2)"| ev_comentario
    st_progreso -.->|"T14 (2 de 2)"| ev_reapertura
    st_analisis -.->|"T15"| ev_derivacion
    st_progreso -.->|"T16"| ev_derivacion

    classDef capaCliente    fill:#1e3a5f,stroke:#4a90d9,stroke-width:2px,color:#eaf2fb
    classDef capaRed        fill:#4a2d0a,stroke:#d99a4a,stroke-width:2px,color:#fdf3e6
    classDef capaApi        fill:#0f3d2e,stroke:#3fbf8f,stroke-width:2px,color:#e8fbf4
    classDef capaAplicacion fill:#123a4d,stroke:#39a8d0,stroke-width:2px,color:#e7f7fd
    classDef capaDominio    fill:#3d2a5c,stroke:#a179e0,stroke-width:2px,color:#f3ecff
    classDef capaInfra      fill:#4a1f2b,stroke:#d9647f,stroke-width:2px,color:#fdeaef
    classDef capaDatos      fill:#2b2b2b,stroke:#9e9e9e,stroke-width:2px,color:#f0f0f0
    classDef capaEventos    fill:#553d0a,stroke:#e0b73f,stroke-width:2px,color:#fff8e1

    class st_inicial,st_abierto,st_analisis,st_progreso,st_resuelto,st_cerrado,st_cancelado capaDominio
    class gd_existe,gd_tecnico,gd_asignado,gd_nota capaDominio
    class err_noexiste,err_transicion,err_tecnico,err_nota,err_permiso capaApi
    class rol_solicitante,rol_operador,rol_tecnico,rol_supervisor capaCliente
    class ev_creacion,ev_cambio,ev_asignacion,ev_resolucion,ev_cierre,ev_cancelacion,ev_comentario,ev_derivacion,ev_reapertura capaEventos
