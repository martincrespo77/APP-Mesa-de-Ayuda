%% =====================================================================
%% Mesa de Ayuda Comunicarlos — Diagrama de Clases Completo y Arquitectura
%% Entidades de Dominio, Fábricas, Servicios de Aplicación, Puertos y Adaptadores
%% Dominio rico: jerarquía polimórfica de Usuario por rol + double dispatch
%% (Requerimiento le PREGUNTA al actor `actor.puede_*(self)`; el actor le
%% consulta al ticket `pertenece_a(self)` / `esta_asignado_a(self)`).
%% Compilado a HTML con scripts de docs/diagramas (ver README).
%% =====================================================================
graph TD

    subgraph sg_dominio["DOMINIO — Jerarquía Polimórfica de Requerimientos"]
        cls_requerimiento["«abstract» Requerimiento<br/>app/requerimientos/dominio/base.py<br/>--- atributos ---<br/>+id: UUID<br/>+titulo: str<br/>+descripcion: str<br/>+solicitante_id: UUID<br/>+estado: EstadoRequerimiento<br/>+fecha_creacion: datetime<br/>+tecnico_asignado_id: UUID | None<br/>+nota_resolucion: str | None<br/>-_historial: list[EventoRequerimiento]<br/>-_comentarios: list[Comentario]<br/>+tipo: TipoRequerimiento (abstract)<br/>--- preguntas del actor ---<br/>+pertenece_a(usuario): bool<br/>+esta_asignado_a(usuario): bool<br/>+esta_abierto(): bool<br/>+exigir_visible_para(actor)<br/>--- transiciones (double dispatch) ---<br/>+iniciar_analisis(actor: Usuario)<br/>+asignar_tecnico(tecnico: Usuario, actor: Usuario)<br/>+iniciar_progreso(actor: Usuario)<br/>+resolver(nota_resolucion, actor: Usuario)<br/>+cerrar(actor: Usuario)<br/>+cancelar(actor: Usuario)<br/>+agregar_comentario(texto, actor: Usuario)<br/>+derivar_interconsulta(tecnico_destino: Usuario, actor: Usuario)"]
        cls_incidente["Incidente (extiende Requerimiento)<br/>app/requerimientos/dominio/incidente.py<br/>--- atributos ---<br/>+urgencia: UrgenciaIncidente<br/>+categoria: CategoriaIncidente<br/>+servicio: ServicioComunicarlos<br/>+pasos_reproduccion: str<br/>+tipo: TipoRequerimiento = INCIDENTE<br/>--- métodos ---<br/>+reconstruir(...)"]
        cls_solicitud["Solicitud (extiende Requerimiento)<br/>app/requerimientos/dominio/solicitud.py<br/>--- atributos ---<br/>+categoria: CategoriaSolicitud<br/>+servicio: ServicioComunicarlos<br/>+tipo: TipoRequerimiento = SOLICITUD<br/>--- métodos ---<br/>+reconstruir(...)"]
        cls_comentario["«value object» Comentario<br/>app/requerimientos/dominio/comentario.py<br/>+id: UUID<br/>+requerimiento_id: UUID<br/>+autor_id: UUID<br/>+texto: str<br/>+timestamp: datetime"]
        cls_evento["«value object» EventoRequerimiento<br/>app/requerimientos/eventos.py<br/>+id: UUID<br/>+requerimiento_id: UUID<br/>+tipo_evento: TipoEventoRequerimiento<br/>+autor_id: UUID<br/>+detalle: str<br/>+timestamp: datetime"]
        cls_fabrica["«factory» FabricaRequerimientos<br/>app/requerimientos/fabrica.py<br/>-_catalogo: dict[TipoRequerimiento, type]<br/>--- métodos ---<br/>+crear(tipo, **atributos)<br/>+reconstruir(tipo, **atributos)<br/>+registrar_tipo(tipo, clase)"]
        cls_validaciones["«module» validaciones (Shared Kernel)<br/>app/compartido/validaciones.py<br/>+texto_obligatorio(valor, campo, recortar=True): str<br/>Valor vacío → DatoInvalidoError (HTTP 422)<br/>+instancia_de(valor, tipo, campo): T<br/>Reemplaza los @staticmethod _validar_*"]
    end

    subgraph sg_usuarios["DOMINIO — Jerarquía Polimórfica de Usuarios (un rol = una clase)"]
        cls_usuario["«abstract» Usuario<br/>app/usuarios/dominio/usuario.py<br/>--- atributos ---<br/>+id: UUID<br/>+nombre_completo: str<br/>-_email: Email<br/>-_password_hash: str<br/>-_activo: bool<br/>-_servicios_suscriptos: frozenset[ServicioComunicarlos]<br/>-_fecha_creacion: datetime<br/>-_ultimo_acceso: datetime | None<br/>+rol: RolUsuario (abstract, discriminador)<br/>--- cuenta ---<br/>+autenticar(password, verificador)<br/>+registrar_acceso()<br/>+activar() / +desactivar()<br/>+cambiar_rol(nuevo_rol): Usuario<br/>+cambiar_password_hash(hash)<br/>+supervisar(empleado) → rechaza<br/>--- Template Method ---<br/>#_exigir_email_admitido(email) (abstract)<br/>#_exigir_suscripciones_admitidas(servicios) (abstract)<br/>--- matriz de roles (por defecto False / sin tickets) ---<br/>+requerimientos_visibles(repo): list[Requerimiento]<br/>+puede_ver(req) / +puede_iniciar_analisis(req)<br/>+puede_asignar_tecnico(req) / +puede_iniciar_progreso(req)<br/>+puede_resolver(req) / +puede_cerrar(req)<br/>+puede_cancelar(req) / +puede_comentar(req)<br/>+puede_derivar(req) / +reabre_al_comentar()<br/>+puede_recibir_requerimientos() / +puede_consultar_tecnicos()<br/>+es_supervisable() / +puede_administrar_usuarios()<br/>+puede_administrar_supervisiones() / +recibe_notificaciones()"]
        cls_solicitante["Solicitante (extiende Usuario)<br/>app/usuarios/dominio/solicitante.py<br/>• Cualquier email; ≥ 1 servicio suscripto<br/>+requerimientos_visibles(repo)<br/>  → repo.listar_por_solicitante(self.id)<br/>+puede_ver / puede_comentar / puede_cerrar(req)<br/>  → req.pertenece_a(self)<br/>+puede_cancelar(req)<br/>  → pertenece_a(self) y esta_abierto()"]
        cls_empleado["«abstract» Empleado (extiende Usuario)<br/>app/usuarios/dominio/empleado.py<br/>• Email @comunicarlos.com.ar obligatorio<br/>• Sin servicios suscriptos<br/>+requerimientos_visibles(repo) → repo.listar_todos()<br/>+puede_ver(req) → True<br/>+puede_consultar_tecnicos() → True"]
        cls_operador["Operador (extiende Empleado)<br/>app/usuarios/dominio/operador.py<br/>+puede_iniciar_analisis / asignar_tecnico → True<br/>+puede_cerrar / cancelar / comentar → True<br/>+reabre_al_comentar() → True<br/>+es_supervisable() → True"]
        cls_tecnico["Tecnico (extiende Empleado)<br/>app/usuarios/dominio/tecnico.py<br/>+puede_iniciar_progreso / resolver(req)<br/>+puede_comentar / derivar(req)<br/>  → req.esta_asignado_a(self)<br/>+reabre_al_comentar() → True<br/>+puede_recibir_requerimientos() → self.activo<br/>+es_supervisable() → True"]
        cls_supervisor["Supervisor (extiende Empleado)<br/>app/usuarios/dominio/supervisor.py<br/>+puede_iniciar_analisis / asignar / iniciar_progreso → True<br/>+puede_resolver / cerrar / cancelar → True<br/>+puede_administrar_usuarios / supervisiones → True<br/>+recibe_notificaciones() → True<br/>+supervisar(empleado): RelacionSupervision"]
        cls_email["«value object» Email<br/>app/usuarios/dominio/email.py<br/>-_valor: str (normalizado: strip + lower)<br/>+pertenece_al_dominio(dominio): bool<br/>+__eq__ / __hash__ / __str__"]
        cls_fabrica_usuarios["«factory» FabricaUsuarios<br/>app/usuarios/dominio/fabrica.py<br/>-_catalogo: dict[RolUsuario, type[Usuario]]<br/>+crear(rol, **atributos): Usuario<br/>Único punto que traduce RolUsuario → clase"]
    end

    subgraph sg_supervision["DOMINIO — Supervisión y Notificaciones"]
        cls_relacion_supervision["RelacionSupervision<br/>app/supervision/dominio.py<br/>+id: UUID<br/>+supervisor_id: UUID<br/>+supervisado_id: UUID<br/>+fecha_asignacion: datetime<br/>+audita_a(usuario_id): bool<br/>+notificar(evento): Notificacion"]
        cls_notificacion["Notificacion<br/>app/notificaciones/dominio.py<br/>+id: UUID<br/>+supervisor_id: UUID<br/>+empleado_supervisado_id: UUID<br/>+requerimiento_id: UUID<br/>+tipo_evento: TipoEventoRequerimiento<br/>+detalle: str<br/>-_leida: bool<br/>+timestamp: datetime<br/>+es_para(supervisor_id): bool<br/>+marcar_leida()<br/>+marcar_leida_por(supervisor_id)"]
