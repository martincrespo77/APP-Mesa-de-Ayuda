        cls_srv_sup["ServicioSupervision<br/>app/supervision/servicios.py<br/>+asignar(supervisor: Usuario, supervisado_id)<br/>+remover(supervisor_id, supervisado_id)<br/>+listar_supervisados_de(supervisor_id)"]
