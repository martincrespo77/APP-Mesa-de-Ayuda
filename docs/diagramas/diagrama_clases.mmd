        cls_deps["Dependencias de seguridad<br/>app/deps.py<br/>+obtener_usuario_actual(token): Usuario<br/>+requerir_permiso(tiene_permiso: Callable[[Usuario], bool])<br/>  ej. lambda u: u.puede_administrar_usuarios()"]
