        port_repo_sup["supervision/repositorio.py::RepositorioSupervision (ABC)<br/>asignar · remover · existe · listar_supervisados_de · listar_supervisores_de"]
        port_repo_notif["notificaciones/repositorio.py::RepositorioNotificaciones (ABC)<br/>guardar · buscar_por_id · listar_por_supervisor"]
        port_observador["notificaciones/observador.py::ObservadorRequerimiento (ABC)<br/>actualizar(evento)"]
    end

    subgraph sg_observer["OBSERVER"]
        obs_despachador("notificaciones/despachador.py::DespachadorEventos<br/>suscribir · desuscribir · notificar · Sujeto/Observable · instancia NUEVA por request")
        obs_logger["notificaciones/observador_logger.py::ObservadorLogger<br/>logger 'mesa_de_ayuda.auditoria' · solo stdlib"]
        obs_mongo["infraestructura/observador_notificaciones.py::ObservadorNotificacionesMongo<br/>si autor es OPERADOR/TECNICO -> 1 Notificacion por supervisor"]
    end

