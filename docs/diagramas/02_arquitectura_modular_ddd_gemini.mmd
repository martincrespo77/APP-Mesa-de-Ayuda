        dom_eventos["requerimientos/eventos.py<br/>EventoRequerimiento (frozen) · TipoEventoRequerimiento (9)"]
        dom_fabrica["requerimientos/fabrica.py::FabricaRequerimientos<br/>Factory Method: crear · reconstruir · registrar_tipo"]
        dom_usuario["usuarios/dominio.py::Usuario<br/>activar · desactivar · cambiar_rol · registrar_acceso · email corporativo · suscripciones"]
        dom_relacion_sup["supervision/dominio.py::RelacionSupervision<br/>invariante: nadie se supervisa a si mismo"]
        dom_notificacion["notificaciones/dominio.py::Notificacion<br/>marcar_leida (idempotente)"]
        dom_exc_req["requerimientos/excepciones.py<br/>TransicionInvalida · TecnicoNoAsignado · NotaResolucionRequerida · PermisoDenegado · RequerimientoNoEncontrado"]
        dom_exc_usr["usuarios/excepciones.py<br/>UsuarioYaActivo/Inactivo · NoEncontrado · EmailYaRegistrado · EmailCorporativoRequerido · SuscripcionRequerida · CredencialesInvalidas"]
        dom_exc_sup["supervision/excepciones.py<br/>RelacionInvalida · RelacionYaExiste · RolNoSupervisable"]
        dom_exc_notif["notificaciones/excepciones.py<br/>NotificacionNoEncontrada"]
    end

