graph TD
    subgraph sg_presentacion["PRESENTACION"]
        pres_main("app/main.py<br/>FastAPI · lifespan · include_router x4 · mount estatico")
        pres_errores{"app/errores.py::codigo_http_para<br/>DominioError -> 401/403/404/409 (default 400 por MRO)"}
