        app_srv_req("ServicioRequerimientos (requerimientos/servicios.py)<br/>crear · obtener_visible_para · listar_visibles_para · iniciar_analisis · asignar_tecnico · iniciar_progreso · resolver · cerrar · cancelar · agregar_comentario · derivar_interconsulta · _aplicar_transicion")
        app_srv_sup("ServicioSupervision (supervision/servicios.py)<br/>asignar (valida rol supervisable) · remover · listar_supervisados_de")
        app_srv_notif("ServicioNotificaciones (notificaciones/servicios.py)<br/>listar_mias · marcar_leida (exige pertenencia)")
    end

    subgraph sg_dominio["DOMINIO"]
        dom_compartido["compartido/dominio.py<br/>RolUsuario · ServicioComunicarlos (Shared Kernel)"]
        dom_error_base["compartido/excepciones.py::DominioError<br/>raiz de toda excepcion de negocio"]
        dom_requerimiento["requerimientos/dominio/base.py::Requerimiento (ABC)<br/>Information Expert: valida estado + rol + identidad"]
        dom_incidente["dominio/incidente.py::Incidente<br/>+ UrgenciaIncidente · CategoriaIncidente"]
        dom_solicitud["dominio/solicitud.py::Solicitud<br/>+ CategoriaSolicitud"]
        dom_comentario["dominio/comentario.py::Comentario (frozen dataclass)<br/>embebido en el agregado"]
