%% =====================================================================
%% Mesa de Ayuda Comunicarlos — Modelo de Dominio y Jerarquia de Clases
%% Sub-plan 3 del Plan Maestro de Diagramacion Tecnica Interactiva
%%
%% DESVIACION DOCUMENTADA: se redacto primero un `classDiagram` completo
%% siguiendo §3.3-§3.5 (ver historial de commit/informe). El compilador
%% del MCP mcp-diagrama-iterativo-mermaid NO interpreta correctamente el
%% cuerpo de las clases: cada linea de atributo/metodo dentro de un bloque
%% `class X { ... }` es reinterpretada por su parser como una declaracion
%% de nodo `id(texto)` de flowchart, generando decenas de nodos espurios
%% (ej. un nodo "iniciar_analisis" con label "autor_id, rol_actor") y
%% perdiendo las clases, atributos y relaciones reales. Se aplica el
%% fallback declarado en §3.5 y §0.2: se regenera como `graph TD` con un
%% nodo-clase por entidad (atributos y metodos en la etiqueta multilinea
%% via <br/>) y se preservan TODAS las relaciones y cardinalidades de
%% §3.4 como etiquetas de arista, ya que la notacion UML de triangulo
%% (herencia) y rombo (composicion) no existe en la gramatica flowchart.
%% =====================================================================
graph TD

    subgraph sg_jerarquia["JERARQUIA POLIMORFICA — Requerimiento (Information Expert)"]
        cls_requerimiento["«abstract» Requerimiento<br/>requerimientos/dominio/base.py<br/>--- atributos ---<br/>+id:UUID +titulo:str +descripcion:str<br/>+solicitante_id:UUID +estado:EstadoRequerimiento<br/>+fecha_creacion:datetime +tecnico_asignado_id:UUID|None<br/>+nota_resolucion:str|None<br/>-_historial:list_EventoRequerimiento -_comentarios:list_Comentario<br/>+historial · property copia defensiva<br/>+comentarios · property copia defensiva<br/>+tipo:TipoRequerimiento · property abstracta<br/>--- metodos ---<br/>+iniciar_analisis · autor_id,rol_actor → EventoRequerimiento<br/>+asignar_tecnico · tecnico_id,autor_id,rol_actor → EventoRequerimiento<br/>+iniciar_progreso · autor_id,rol_actor → EventoRequerimiento<br/>+resolver · nota_resolucion,autor_id,rol_actor → EventoRequerimiento<br/>+cerrar · autor_id,rol_actor → EventoRequerimiento<br/>+cancelar · autor_id,rol_actor → EventoRequerimiento<br/>+agregar_comentario · texto,autor_id,rol_actor → Comentario<br/>+derivar_interconsulta · tecnico_destino_id,autor_id,rol_actor → EventoRequerimiento<br/>#_reconstruir_base$ · protegido, uso exclusivo de repositorios<br/>-_exigir_estado -_exigir_rol$ -_exigir_rol_o_asignado<br/>-_exigir_permiso_comentario -_registrar_evento<br/>-_validar_titulo$ -_validar_descripcion$ -_validar_texto_comentario$<br/>--- constantes de modulo ---<br/>_ROLES_ASIGNACION = _ROLES_CIERRE = _ROLES_CANCELACION_AMPLIA = OPERADOR,SUPERVISOR<br/>_ROLES_REABREN_AL_COMENTAR = OPERADOR,TECNICO<br/>_ESTADOS_SIN_COMENTARIOS = CERRADO,CANCELADO<br/>_ESTADOS_DERIVABLES = EN_ANALISIS,EN_PROGRESO"]
        cls_incidente["Incidente · extiende Requerimiento<br/>requerimientos/dominio/incidente.py<br/>+urgencia:UrgenciaIncidente<br/>+categoria:CategoriaIncidente<br/>+servicio:ServicioComunicarlos<br/>+pasos_reproduccion:str<br/>+tipo:TipoRequerimiento = INCIDENTE<br/>+reconstruir$ · campos completos → Incidente<br/>-_validar_urgencia$ -_validar_categoria$<br/>-_validar_servicio$ -_validar_pasos_reproduccion$"]
        cls_solicitud["Solicitud · extiende Requerimiento<br/>requerimientos/dominio/solicitud.py<br/>+categoria:CategoriaSolicitud<br/>+servicio:ServicioComunicarlos<br/>+tipo:TipoRequerimiento = SOLICITUD<br/>+reconstruir$ · campos completos → Solicitud<br/>-_validar_categoria$ -_validar_servicio$"]
    end

    subgraph sg_embebidas["ENTIDADES EMBEBIDAS — composicion, sin ciclo de vida propio"]
        cls_comentario["«frozen dataclass» Comentario<br/>requerimientos/dominio/comentario.py<br/>+requerimiento_id:UUID +autor_id:UUID<br/>+texto:str +id:UUID = uuid4<br/>+timestamp:datetime = now UTC<br/>sin validacion propia · la valida Requerimiento.agregar_comentario"]
        cls_evento["«frozen dataclass» EventoRequerimiento<br/>requerimientos/eventos.py<br/>+requerimiento_id:UUID +tipo_evento:TipoEventoRequerimiento<br/>+autor_id:UUID +detalle:str<br/>+id:UUID +timestamp:datetime"]
    end

    subgraph sg_usuario["USUARIO"]
        cls_usuario["Usuario<br/>usuarios/dominio.py<br/>+id:UUID +nombre_completo:str +email:str<br/>-_rol:RolUsuario -_password_hash:str -_activo:bool<br/>-_servicios_suscriptos:frozenset_ServicioComunicarlos<br/>-_fecha_creacion:datetime -_ultimo_acceso:datetime|None<br/>+rol +activo +password_hash +servicios_suscriptos<br/>+fecha_creacion +ultimo_acceso · properties<br/>+registrar_acceso +activar +desactivar<br/>+cambiar_rol · nuevo_rol<br/>+cambiar_password_hash · nuevo_password_hash<br/>-_validar_nombre_completo$ -_validar_email$<br/>-_validar_dominio_corporativo$ · OPERADOR/TECNICO/SUPERVISOR exigen @comunicarlos.com.ar<br/>-_validar_password_hash$ -_validar_rol$<br/>-_validar_servicios_suscriptos$ · SOLICITANTE exige 1+ servicio; otros roles 0"]
    end

    subgraph sg_supervision["SUPERVISION — clase-asociacion N:M"]
        cls_relacion_supervision["RelacionSupervision<br/>supervision/dominio.py<br/>+id:UUID +supervisor_id:UUID<br/>+supervisado_id:UUID +fecha_asignacion:datetime<br/>invariante en __init__ · supervisor_id distinto de supervisado_id → RelacionInvalidaError<br/>regla de servicio · supervisado debe ser OPERADOR o TECNICO → RolNoSupervisableError"]
    end

    subgraph sg_notificacion["NOTIFICACION"]
        cls_notificacion["Notificacion<br/>notificaciones/dominio.py<br/>+id:UUID +supervisor_id:UUID<br/>+empleado_supervisado_id:UUID +requerimiento_id:UUID<br/>+tipo_evento:TipoEventoRequerimiento +detalle:str +timestamp:datetime<br/>-_leida:bool +leida · property<br/>+marcar_leida · idempotente<br/>1 Notificacion por evento x supervisor"]
    end

    subgraph sg_fabrica["FABRICA — Factory Method"]
        cls_fabrica["FabricaRequerimientos<br/>requerimientos/fabrica.py<br/>-_catalogo:dict TipoRequerimiento a type<br/>+crear$ · tipo,atributos → Requerimiento<br/>+reconstruir$ · tipo,atributos → Requerimiento<br/>+registrar_tipo$ · tipo,clase_requerimiento"]
    end

    subgraph sg_puertos["PUERTOS — interfaces ABC, Dependency Inversion"]
        cls_puerto_repo_req["«interface» RepositorioRequerimientos<br/>requerimientos/repositorio.py<br/>+guardar* · requerimiento<br/>+buscar_por_id* · requerimiento_id → Requerimiento|None<br/>+listar_todos* → list_Requerimiento<br/>+listar_por_solicitante* · solicitante_id → list_Requerimiento"]
        cls_puerto_repo_usr["«interface» RepositorioUsuarios<br/>usuarios/repositorio.py<br/>+guardar* · usuario<br/>+buscar_por_id* · usuario_id → Usuario|None<br/>+buscar_por_email* · email → Usuario|None<br/>+listar_todos* → list_Usuario"]
        cls_puerto_repo_sup["«interface» RepositorioSupervision<br/>supervision/repositorio.py<br/>+asignar* · relacion<br/>+remover* · supervisor_id,supervisado_id<br/>+existe* · supervisor_id,supervisado_id → bool<br/>+listar_supervisados_de* → list_RelacionSupervision<br/>+listar_supervisores_de* → list_RelacionSupervision"]
        cls_puerto_repo_notif["«interface» RepositorioNotificaciones<br/>notificaciones/repositorio.py<br/>+guardar* · notificacion<br/>+buscar_por_id* · notificacion_id → Notificacion|None<br/>+listar_por_supervisor* · supervisor_id → list_Notificacion"]
        cls_puerto_observador["«interface» ObservadorRequerimiento<br/>notificaciones/observador.py<br/>+actualizar* · evento"]
    end

    subgraph sg_enumeraciones["ENUMERACIONES — StrEnum, 8 clases"]
        enum_rol["«enumeration» RolUsuario<br/>compartido/dominio.py<br/>SOLICITANTE<br/>OPERADOR<br/>TECNICO<br/>SUPERVISOR"]
        enum_servicio["«enumeration» ServicioComunicarlos<br/>compartido/dominio.py<br/>TELEFONIA_CELULAR<br/>INTERNET_BANDA_ANCHA<br/>TELEVISION"]
        enum_estado["«enumeration» EstadoRequerimiento<br/>requerimientos/dominio/estados.py<br/>ABIERTO<br/>EN_ANALISIS<br/>EN_PROGRESO<br/>RESUELTO<br/>CERRADO<br/>CANCELADO"]
        enum_tipo_req["«enumeration» TipoRequerimiento<br/>requerimientos/dominio/estados.py<br/>INCIDENTE<br/>SOLICITUD"]
        enum_urgencia["«enumeration» UrgenciaIncidente<br/>requerimientos/dominio/incidente.py<br/>CRITICO<br/>IMPORTANTE<br/>MENOR"]
        enum_categoria_incidente["«enumeration» CategoriaIncidente<br/>requerimientos/dominio/incidente.py<br/>SERVICIO_INACCESIBLE<br/>BLOQUEO_SIM<br/>PERDIDA_O_DESTRUCCION_DE_EQUIPO"]
        enum_categoria_solicitud["«enumeration» CategoriaSolicitud<br/>requerimientos/dominio/solicitud.py<br/>ALTA_SERVICIO<br/>BAJA_SERVICIO"]
        enum_tipo_evento["«enumeration» TipoEventoRequerimiento<br/>requerimientos/eventos.py<br/>CREACION<br/>CAMBIO_ESTADO<br/>ASIGNACION<br/>RESOLUCION<br/>CIERRE<br/>CANCELACION<br/>COMENTARIO<br/>DERIVACION<br/>REAPERTURA"]
    end

    subgraph sg_excepciones["JERARQUIA DE EXCEPCIONES — DominioError + 16 clases"]
        exc_dominio_error["«exception» DominioError<br/>compartido/excepciones.py<br/>raiz de toda excepcion de negocio<br/>capturada por exception_handler DominioError en app/main.py"]
        exc_requerimiento_error["«exception» RequerimientoError<br/>requerimientos/excepciones.py · base"]
        exc_transicion_invalida["«exception» TransicionInvalidaError<br/>cambio de estado no permitido → HTTP 409"]
        exc_tecnico_no_asignado["«exception» TecnicoNoAsignadoError<br/>iniciar_progreso sin tecnico asignado → HTTP 409"]
        exc_nota_resolucion_requerida["«exception» NotaResolucionRequeridaError<br/>resolver sin nota descriptiva → HTTP 409"]
        exc_permiso_denegado["«exception» PermisoDenegadoError<br/>rol/identidad no autoriza la operacion → HTTP 403"]
        exc_requerimiento_no_encontrado["«exception» RequerimientoNoEncontradoError<br/>id de requerimiento inexistente → HTTP 404"]
        exc_usuario_error["«exception» UsuarioError<br/>usuarios/excepciones.py · base"]
        exc_usuario_ya_activo["«exception» UsuarioYaActivoError<br/>activar un usuario ya activo"]
        exc_usuario_ya_inactivo["«exception» UsuarioYaInactivoError<br/>desactivar un usuario ya inactivo"]
        exc_usuario_no_encontrado["«exception» UsuarioNoEncontradoError<br/>id de usuario inexistente"]
        exc_email_ya_registrado["«exception» EmailYaRegistradoError<br/>registrar un email ya en uso"]
        exc_email_corporativo_requerido["«exception» EmailCorporativoRequeridoError<br/>OPERADOR/TECNICO/SUPERVISOR sin email @comunicarlos.com.ar"]
        exc_suscripcion_requerida["«exception» SuscripcionRequeridaError<br/>SOLICITANTE sin servicios suscriptos, u otro rol con servicios"]
        exc_credenciales_invalidas["«exception» CredencialesInvalidasError<br/>login con email/password incorrectos o usuario inactivo"]
        exc_supervision_error["«exception» SupervisionError<br/>supervision/excepciones.py · base"]
        exc_relacion_invalida["«exception» RelacionInvalidaError<br/>relacion inconsistente · autosupervision"]
        exc_relacion_ya_existe["«exception» RelacionYaExisteError<br/>relacion supervisor/supervisado ya existente"]
        exc_rol_no_supervisable["«exception» RolNoSupervisableError<br/>supervisado sin rol supervisable"]
        exc_notificacion_error["«exception» NotificacionError<br/>notificaciones/excepciones.py · base"]
        exc_notificacion_no_encontrada["«exception» NotificacionNoEncontradaError<br/>notificacion inexistente o ajena al supervisor"]
    end

    %% --- Herencia (triangulo UML no disponible en flowchart: se etiqueta) ---
    cls_incidente ==>|"herencia: Incidente hereda de Requerimiento"| cls_requerimiento
    cls_solicitud ==>|"herencia: Solicitud hereda de Requerimiento"| cls_requerimiento

    %% --- Composicion (rombo lleno UML no disponible: se etiqueta) ---
    cls_requerimiento ==>|"1 compone 0..* · historial embebido, sin ciclo de vida propio"| cls_evento
    cls_requerimiento ==>|"1 compone 0..* · comentarios embebidos, sin ciclo de vida propio"| cls_comentario

    %% --- Dependencias tipadas hacia enumeraciones ---
    cls_requerimiento -->|"1 a 1 · estado"| enum_estado
    cls_requerimiento -.->|"1 a 1 · tipo, discriminador polimorfico"| enum_tipo_req
    cls_incidente -->|"1 a 1 · urgencia"| enum_urgencia
    cls_incidente -->|"1 a 1 · categoria"| enum_categoria_incidente
    cls_incidente -->|"1 a 1 · servicio"| enum_servicio
    cls_solicitud -->|"1 a 1 · categoria"| enum_categoria_solicitud
    cls_solicitud -->|"1 a 1 · servicio"| enum_servicio
    cls_evento -->|"1 a 1 · tipo_evento"| enum_tipo_evento

    %% --- Usuario: propiedades tipadas y referencias por id (NO asociacion de objetos) ---
    cls_usuario -->|"1 a 1 · rol"| enum_rol
    cls_usuario -->|"1 a 0..* · servicios_suscriptos, frozenset"| enum_servicio
    cls_usuario -.->|"1 a 0..* · solicitante_id, referencia por id, NO objeto Usuario"| cls_requerimiento
    cls_usuario -.->|"0..1 a 0..* · tecnico_asignado_id, referencia por id, maximo 1 a la vez"| cls_requerimiento
    cls_usuario -.->|"1 a 0..* · autor_id, referencia por id"| cls_comentario
    cls_usuario -.->|"1 a 0..* · autor_id, referencia por id"| cls_evento
    cls_usuario -->|"1 a 0..* · supervisor_id"| cls_relacion_supervision
    cls_usuario -->|"1 a 0..* · supervisado_id"| cls_relacion_supervision
    cls_relacion_supervision -->|"0..* a 1 · N a M Supervisor con Operador/Tecnico"| cls_usuario

    %% --- Notificacion ---
    cls_notificacion -->|"0..* a 1 · supervisor_id destinatario"| cls_usuario
    cls_notificacion -.->|"0..* a 1 · requerimiento_id"| cls_requerimiento
    cls_notificacion -->|"1 a 1 · tipo_evento"| enum_tipo_evento

    %% --- Fabrica ---
    cls_fabrica -.->|"crea / reconstruye · Factory Method"| cls_incidente
    cls_fabrica -.->|"crea / reconstruye"| cls_solicitud
    cls_fabrica -.->|"catalogo indexado por"| enum_tipo_req

    %% --- Puertos: persisten/observan la abstraccion del dominio ---
    cls_puerto_repo_req -.->|"persiste la abstraccion"| cls_requerimiento
    cls_puerto_repo_usr -.->|"persiste"| cls_usuario
    cls_puerto_repo_sup -.->|"persiste"| cls_relacion_supervision
    cls_puerto_repo_notif -.->|"persiste"| cls_notificacion
    cls_puerto_observador -.->|"actualizar evento · Observer"| cls_evento

    %% --- Excepciones lanzadas por las entidades de negocio ---
    cls_requerimiento -.->|"raise"| exc_requerimiento_error
    cls_usuario -.->|"raise"| exc_usuario_error
    cls_relacion_supervision -.->|"raise en __init__"| exc_relacion_invalida
    cls_notificacion -.->|"raise via ServicioNotificaciones"| exc_notificacion_error

    %% --- Jerarquia de excepciones (herencia, misma convencion que arriba) ---
    exc_requerimiento_error ==>|"hereda de"| exc_dominio_error
    exc_transicion_invalida ==>|"hereda de"| exc_requerimiento_error
    exc_tecnico_no_asignado ==>|"hereda de"| exc_requerimiento_error
    exc_nota_resolucion_requerida ==>|"hereda de"| exc_requerimiento_error
    exc_permiso_denegado ==>|"hereda de"| exc_requerimiento_error
    exc_requerimiento_no_encontrado ==>|"hereda de"| exc_requerimiento_error

    exc_usuario_error ==>|"hereda de"| exc_dominio_error
    exc_usuario_ya_activo ==>|"hereda de"| exc_usuario_error
    exc_usuario_ya_inactivo ==>|"hereda de"| exc_usuario_error
    exc_usuario_no_encontrado ==>|"hereda de"| exc_usuario_error
    exc_email_ya_registrado ==>|"hereda de"| exc_usuario_error
    exc_email_corporativo_requerido ==>|"hereda de"| exc_usuario_error
    exc_suscripcion_requerida ==>|"hereda de"| exc_usuario_error
    exc_credenciales_invalidas ==>|"hereda de"| exc_usuario_error

    exc_supervision_error ==>|"hereda de"| exc_dominio_error
    exc_relacion_invalida ==>|"hereda de"| exc_supervision_error
    exc_relacion_ya_existe ==>|"hereda de"| exc_supervision_error
    exc_rol_no_supervisable ==>|"hereda de"| exc_supervision_error

    exc_notificacion_error ==>|"hereda de"| exc_dominio_error
    exc_notificacion_no_encontrada ==>|"hereda de"| exc_notificacion_error

    classDef capaDominio    fill:#3d2a5c,stroke:#a179e0,stroke-width:2px,color:#f3ecff
    classDef capaAplicacion fill:#123a4d,stroke:#39a8d0,stroke-width:2px,color:#e7f7fd
    classDef capaEventos    fill:#553d0a,stroke:#e0b73f,stroke-width:2px,color:#fff8e1
    classDef capaInfra      fill:#4a1f2b,stroke:#d9647f,stroke-width:2px,color:#fdeaef

    class cls_requerimiento,cls_incidente,cls_solicitud,cls_comentario,cls_evento,cls_usuario,cls_relacion_supervision,cls_notificacion capaDominio
    class cls_fabrica,cls_puerto_repo_req,cls_puerto_repo_usr,cls_puerto_repo_sup,cls_puerto_repo_notif,cls_puerto_observador capaAplicacion
    class enum_rol,enum_servicio,enum_estado,enum_tipo_req,enum_urgencia,enum_categoria_incidente,enum_categoria_solicitud,enum_tipo_evento capaEventos
    class exc_dominio_error,exc_requerimiento_error,exc_transicion_invalida,exc_tecnico_no_asignado,exc_nota_resolucion_requerida,exc_permiso_denegado,exc_requerimiento_no_encontrado,exc_usuario_error,exc_usuario_ya_activo,exc_usuario_ya_inactivo,exc_usuario_no_encontrado,exc_email_ya_registrado,exc_email_corporativo_requerido,exc_suscripcion_requerida,exc_credenciales_invalidas,exc_supervision_error,exc_relacion_invalida,exc_relacion_ya_existe,exc_rol_no_supervisable,exc_notificacion_error,exc_notificacion_no_encontrada capaInfra
