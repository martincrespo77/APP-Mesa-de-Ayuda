classDiagram
    %% Requerimiento y tipos
    class Requerimiento {
        <<abstract>>
        +id : UUID
        +titulo : str
        +descripcion : str
        +solicitante_id : UUID
        +estado : EstadoRequerimiento
        +fecha_creacion : datetime
        +tecnico_asignado_id : UUID|None
        +nota_resolucion : str|None
        -_historial : list[EventoRequerimiento]
        -_comentarios : list[Comentario]
        +historial : list[EventoRequerimiento]
        +comentarios : list[Comentario]
        +tipo* : TipoRequerimiento
        +iniciar_analisis(autor_id, rol_actor) EventoRequerimiento
        +asignar_tecnico(tecnico_id, autor_id, rol_actor) EventoRequerimiento
        +iniciar_progreso(autor_id, rol_actor) EventoRequerimiento
        +resolver(nota_resolucion, autor_id, rol_actor) EventoRequerimiento
        +cerrar(autor_id, rol_actor) EventoRequerimiento
        +cancelar(autor_id, rol_actor) EventoRequerimiento
        +agregar_comentario(texto, autor_id, rol_actor) Comentario
        +derivar_interconsulta(tecnico_destino_id, autor_id, rol_actor) EventoRequerimiento
        #_reconstruir_base(...)$ Requerimiento
        -_exigir_estado(estado_requerido)
        -_exigir_rol(rol_actor, roles_permitidos, accion)
        -_exigir_rol_o_asignado(autor_id, rol_actor, accion)
        -_exigir_permiso_comentario(autor_id, rol_actor)
        -_registrar_evento(tipo_evento, autor_id, detalle) EventoRequerimiento
        -_validar_titulo(titulo) str
        -_validar_descripcion(descripcion) str
        -_validar_texto_comentario(texto) str
    }
    note for Requerimiento "_ROLES_ASIGNACION={OPERADOR,SUPERVISOR}\n_ROLES_CIERRE={OPERADOR,SUPERVISOR}\n_ROLES_CANCELACION_AMPLIA={OPERADOR,SUPERVISOR}\n_ROLES_REABREN_AL_COMENTAR={OPERADOR,TECNICO}\n_ESTADOS_SIN_COMENTARIOS={CERRADO,CANCELADO}\n_ESTADOS_DERIVABLES={EN_ANALISIS,EN_PROGRESO}"
    
    class Incidente {
        +urgencia : UrgenciaIncidente
        +categoria : CategoriaIncidente
        +servicio : ServicioComunicarlos
        +pasos_reproduccion : str
        +tipo : TipoRequerimiento
        +reconstruir(...)$ Incidente
        -_validar_urgencia()
        -_validar_categoria()
        -_validar_servicio()
        -_validar_pasos_reproduccion()
    }
    note for Incidente "tipo = INCIDENTE"

    class Solicitud {
        +categoria : CategoriaSolicitud
        +servicio : ServicioComunicarlos
        +tipo : TipoRequerimiento
        +reconstruir(...)$ Solicitud
        -_validar_categoria()
        -_validar_servicio()
    }
    note for Solicitud "tipo = SOLICITUD"

    class Comentario {
        +requerimiento_id : UUID
        +autor_id : UUID
        +texto : str
        +id : UUID
        +timestamp : datetime
    }
    note for Comentario "Frozen Dataclass, id default uuid4, timestamp default now(UTC)"

    class EventoRequerimiento {
        +requerimiento_id : UUID
        +tipo_evento : TipoEventoRequerimiento
        +autor_id : UUID
        +detalle : str
        +id : UUID
        +timestamp : datetime
    }
    note for EventoRequerimiento "Frozen Dataclass"

    class Usuario {
        +id : UUID
        +nombre_completo : str
        +email : str
        -_rol : RolUsuario
        -_password_hash : str
        -_activo : bool
        -_servicios_suscriptos : frozenset[ServicioComunicarlos]
        -_fecha_creacion : datetime
        -_ultimo_acceso : datetime|None
        +rol : RolUsuario
        +activo : bool
        +password_hash : str
        +servicios_suscriptos : frozenset[ServicioComunicarlos]
        +fecha_creacion : datetime
        +ultimo_acceso : datetime|None
        +registrar_acceso()
        +activar()
        +desactivar()
        +cambiar_rol(nuevo_rol)
        +cambiar_password_hash(nuevo_password_hash)
        -_validar_email(email, rol) str
        -_validar_dominio_corporativo(email, rol)$
        -_validar_servicios_suscriptos(servicios, rol)$
    }

    class RelacionSupervision {
        +id : UUID
        +supervisor_id : UUID
        +supervisado_id : UUID
        +fecha_asignacion : datetime
        +invariante_supervisor_distinto()
    }

    class Notificacion {
        +id : UUID
        +supervisor_id : UUID
        +empleado_supervisado_id : UUID
        +requerimiento_id : UUID
        +tipo_evento : TipoEventoRequerimiento
        +detalle : str
        +timestamp : datetime
        -_leida : bool
        +leida : bool
        +marcar_leida()
    }
    note for Notificacion "1 por evento × supervisor\nmarcar_leida() es idempotente"

    %% Enumeraciones
    class RolUsuario {
        <<enumeration>>
        SOLICITANTE
        OPERADOR
        TECNICO
        SUPERVISOR
    }
    class ServicioComunicarlos {
        <<enumeration>>
        TELEFONIA_CELULAR
        INTERNET_BANDA_ANCHA
        TELEVISION
    }
    class EstadoRequerimiento {
        <<enumeration>>
        ABIERTO
        EN_ANALISIS
        EN_PROGRESO
        RESUELTO
        CERRADO
        CANCELADO
    }
    class TipoRequerimiento {
        <<enumeration>>
        INCIDENTE
        SOLICITUD
    }
    class UrgenciaIncidente {
        <<enumeration>>
        CRITICO
        IMPORTANTE
        MENOR
    }
    class CategoriaIncidente {
        <<enumeration>>
        SERVICIO_INACCESIBLE
        BLOQUEO_SIM
        PERDIDA_O_DESTRUCCION_DE_EQUIPO
    }
    class CategoriaSolicitud {
        <<enumeration>>
        ALTA_SERVICIO
        BAJA_SERVICIO
    }
    class TipoEventoRequerimiento {
        <<enumeration>>
        CREACION
        CAMBIO_ESTADO
        ASIGNACION
        RESOLUCION
        CIERRE
        CANCELACION
        COMENTARIO
        DERIVACION
        REAPERTURA
    }

    %% Fabrica y puertos
    class FabricaRequerimientos {
        -_catalogo : dict
        +crear(tipo, **atributos)$
        +reconstruir(tipo, **atributos)$
        +registrar_tipo(tipo, clase)$
    }

    class RepositorioRequerimientos {
        <<interface>>
        +guardar()
        +buscar_por_id()
        +listar_todos()
        +listar_por_solicitante()
    }
    class RepositorioUsuarios {
        <<interface>>
        +guardar()
        +buscar_por_id()
        +buscar_por_email()
        +listar_todos()
    }
    class RepositorioSupervision {
        <<interface>>
        +asignar()
        +remover()
        +existe()
        +listar_supervisados_de()
        +listar_supervisores_de()
    }
    class RepositorioNotificaciones {
        <<interface>>
        +guardar()
        +buscar_por_id()
        +listar_por_supervisor()
    }
    class ObservadorRequerimiento {
        <<interface>>
        +actualizar(evento)
    }

