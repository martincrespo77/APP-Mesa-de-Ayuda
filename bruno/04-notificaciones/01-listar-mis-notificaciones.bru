meta {
  name: 01 Listar Mis Notificaciones (Supervisor)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/notificaciones
  auth: bearer
}

auth:bearer {
  token: {{token_supervisor}}
}

assert {
  res.status: eq 200
  res.body.length: gte 1
}

script:post-response {
  bru.setEnvVar("notificacion_id", res.body[0].id);
}

docs {
  Requiere haber corrido antes "03-supervision" completo (la relación de
  supervisión y el comentario del Operador que dispara la notificación).
}
