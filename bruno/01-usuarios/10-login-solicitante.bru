meta {
  name: 10 Login Solicitante
  type: http
  seq: 10
}

post {
  url: {{base_url}}/usuarios/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{email_solicitante}}
  password: {{password_seed}}
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("token_solicitante", res.body.access_token);
}
