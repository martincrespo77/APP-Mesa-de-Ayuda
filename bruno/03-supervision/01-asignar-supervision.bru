meta {
  name: 01 Asignar Supervisión (Supervisor -> Operador)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/supervisiones
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_supervisor}}
}

body:json {
  {
    "supervisado_id": "{{operador_id}}"
  }
}

assert {
  res.status: eq 201
  res.body.supervisado_id: eq {{operador_id}}
}

docs {
  Requiere haber corrido antes "01-usuarios/13 Obtener Mi Perfil (Operador)".
}
