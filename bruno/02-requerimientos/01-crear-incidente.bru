meta {
  name: 01 Crear Incidente
  type: http
  seq: 1
}

post {
  url: {{base_url}}/requerimientos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token_solicitante}}
}

body:json {
  {
    "tipo": "INCIDENTE",
    "titulo": "Corte de fibra (Bruno)",
    "descripcion": "Sin conectividad desde esta mañana.",
    "urgencia": "IMPORTANTE",
    "categoria": "SERVICIO_INACCESIBLE",
    "servicio": "INTERNET_BANDA_ANCHA",
    "pasos_reproduccion": "Verificar ONT sin luz de señal."
  }
}

assert {
  res.status: eq 201
  res.body.tipo: eq INCIDENTE
  res.body.estado: eq ABIERTO
  res.body.historial.length: eq 1
}

script:post-response {
  bru.setEnvVar("incidente_id", res.body.id);
}
