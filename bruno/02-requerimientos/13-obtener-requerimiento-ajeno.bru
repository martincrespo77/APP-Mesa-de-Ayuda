meta {
  name: 13 Obtener Requerimiento Ajeno (otro Solicitante)
  type: http
  seq: 13
}

get {
  url: {{base_url}}/requerimientos/{{incidente_id}}
  auth: bearer
}

auth:bearer {
  token: {{token_solicitante2}}
}

assert {
  res.status: eq 403
}

docs {
  Fix de seguridad: un Solicitante no puede consultar el requerimiento de
  otro (mismo criterio que el listado, ahora también en GET /{id}).
  Requiere haber corrido antes "12 Login Solicitante 2".
}
